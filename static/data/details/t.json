"tevent":{"upstreams":[{"url":"https://www.samba.org/ftp/tevent/tevent-0.17.2.tar.gz","hash":"e53b1ac288d017d66dde0471cd429a806168ecf07179d7f019572d7a7e05f0d6","type":"tarball"}],"setup":"%configure \\\n    --bundled-libraries=NONE \\\n    --builtin-libraries=replace \\\n    --disable-rpath-install \\\n    --disable-python\n","build":"%make\n","install":"%make_install\n","tuning":["[object Object]"]},
