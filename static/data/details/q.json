"qt6-base":{"upstreams":[{"url":"https://download.qt.io/official_releases/qt/6.12/6.12.0/submodules/qtbase-everywhere-src-6.12.0.tar.xz","hash":"a951bd163c7b80fc6b8c88d7668fb56abf91c152373e13c10666763238131307","type":"tarball"}],"setup":"%patch %(pkgdir)/0001-Adjust-build-flags.patch\n%patch %(pkgdir)/0001-Support-stateless-config-directories.patch\n\n# Qt 6.11 regression (for us)\n%patch %(pkgdir)/0001-fix-Don-t-install-bindir-if-no-user-facing-tools-exi.patch\n\n# The default Qt6 render loop runs at ~60fps which makes animations look choppy on higher fps monitors. Bump this up to ~120fps\n%patch %(pkgdir)/0001-Run-render-tick-at-120fps.patch\n\n# Upstream backports\n%patch %(pkgdir)/QTBUG-146211.patch\n%patch %(pkgdir)/QTBUG-151163.patch\n%patch %(pkgdir)/QTBUG-148575.patch\n%patch %(pkgdir)/QTBUG-149231.patch\n%patch %(pkgdir)/QTBUG-149921.patch\n%patch %(pkgdir)/QTBUG-150279.patch\n%patch %(pkgdir)/QTBUG-150280.patch\n%patch %(pkgdir)/QTBUG-150353.patch\n%patch %(pkgdir)/QTBUG-150982-prereq.patch\n%patch %(pkgdir)/QTBUG-150982.patch\n%patch %(pkgdir)/upstream-01.patch\n%patch %(pkgdir)/upstream-02.patch\n%patch %(pkgdir)/upstream-03.patch\n\n# Wayland: keymap crash on a non-NUL-terminated compositor keymap, stale shm buffer DPR,\n# focus reason on window activation\n%patch %(pkgdir)/QTBUG-151282.patch\n%patch %(pkgdir)/QTBUG-151525.patch\n%patch %(pkgdir)/upstream-04.patch\n\n# QHeaderView low-memory mode, QIcon scaled-decode aspect ratio, text layout memory regression\n%patch %(pkgdir)/upstream-05.patch\n%patch %(pkgdir)/upstream-06.patch\n%patch %(pkgdir)/QTBUG-150286.patch\n\n# shared-mime-info 2.5 magic parsing and tie-breaking\n%patch %(pkgdir)/upstream-07.patch\n%patch %(pkgdir)/upstream-08.patch\n\n# Fractional scaling: zero-width cursor, QIcon cached entry DPR, QCommonStyle icon rect\n%patch %(pkgdir)/QTBUG-109643.patch\n%patch %(pkgdir)/QTBUG-148523.patch\n%patch %(pkgdir)/QTBUG-148522.patch\n\n# Desktop integration: X11 clipboard managers, portal file dialog reuse, canonical\n# applicationFilePath(), mailto via the portal\n%patch %(pkgdir)/QTBUG-108346.patch\n%patch %(pkgdir)/QTBUG-150535.patch\n%patch %(pkgdir)/upstream-09.patch\n%patch %(pkgdir)/upstream-10.patch\n%patch %(pkgdir)/upstream-11.patch\n%patch %(pkgdir)/upstream-12.patch\n\n# Don't leak passwords in URL error messages\n%patch %(pkgdir)/QTBUG-151290.patch\n\n# Only the PGO workload stages need the test suite. The final stage must not\n# build it, or the test data gets installed into /usr/tests.\n_qt_test_arg=\"-DQT_BUILD_TESTS=OFF\"\nif [[ \"${PGO_STAGE}\" == \"ONE\" || \"${PGO_STAGE}\" == \"TWO\" ]]; then\n    _qt_test_arg=\"-DQT_BUILD_TESTS=ON\"\nfi\n\n# This is higher than we probably need but if it's too low some of the clang warnings will leak into stderr during\n# tests and cause unnecessary failures\nexport CFLAGS+=\" -mllvm -vp-counters-per-site=20\"\nexport CXXFLAGS+=\" -mllvm -vp-counters-per-site=20\"\n\n%cmake_qt6 \\\n    \"${_qt_test_arg}\" \\\n    -DQT_QMAKE_TARGET_MKSPEC=linux-clang \\\n    -DQT_FEATURE_accessibility=ON \\\n    -DQT_FEATURE_brotli=ON \\\n    -DQT_FEATURE_dbus_linked=ON \\\n    -DQT_FEATURE_emojisegmenter=ON \\\n    -DQT_FEATURE_force_system_libs=ON \\\n    -DQT_FEATURE_gssapi=ON \\\n    -DQT_FEATURE_harfbuzz=ON \\\n    -DQT_FEATURE_journald=ON \\\n    -DQT_FEATURE_libproxy=ON \\\n    -DQT_FEATURE_mimetype_database=OFF \\\n    -DQT_FEATURE_mtdev=ON \\\n    -DQT_FEATURE_openssl_linked=ON \\\n    -DQT_FEATURE_optimize_full=ON \\\n    -DQT_FEATURE_pcre2=ON \\\n    -DQT_FEATURE_system_harfbuzz=ON \\\n    -DQT_FEATURE_system_sqlite=ON \\\n    -DQT_FEATURE_system_xcb_xinput=ON \\\n    -DQT_FEATURE_zstd=ON\n","build":"%ccache_zero\n\n%cmake_build\n\n%ccache_stats\n","install":"%cmake_install\n\n# Avoid debug logging unless overridden by user\n%install_file %(pkgdir)/qtlogging.ini %(installroot)/usr/share/qt6/qtlogging.ini\n\n# If we used ccache during this build then the ccache config key will be used for EVERY qt6 package build. We want to avoid that.\nsed -i \"s| ccache||g\" %(installroot)/%(libdir)/qt6/mkspecs/qmodule.pri\nsed -i \"s| ccache||g\" %(installroot)/%(libdir)/qt6/mkspecs/modules/qt_lib_core_private.pri\n\n# We have the dedicated qt6-docs package for that.\nrm -rfv %(installroot)/%(datadir)/doc\n\n# Used for Qt CI\nrm -rfv %(installroot)%(libdir)/qt6/ensure_pro_file.cmake \\\n        %(installroot)%(libdir)/qt6/qt-android-runner.py \\\n        %(installroot)%(libdir)/qt6/qt-testrunner.py \\\n        %(installroot)%(libdir)/qt6/sanitizer-testrunner.py\n\n# Not used for desktop installs\nrm -rfv %(installroot)%(libdir)/cmake/Qt6ExamplesAssetDownloaderPrivate \\\n        %(installroot)%(includedir)/qt6/QtExamplesAssetDownloader \\\n        %(installroot)%(libdir)/qt6/metatypes/qt6examplesassetdownloaderprivate*.json \\\n        %(installroot)%(libdir)/qt6/modules/ExamplesAssetDownloaderPrivate.json \\\n        %(installroot)%(libdir)/libQt6ExamplesAssetDownloader* \\\n        %(installroot)%(libdir)/qt6/mkspecs/features/uikit\n","subpackages":[null,{"description":"Qt6 GUI-related libraries","paths":["/usr/lib/libQt6Egl*so.*","/usr/lib/libQt6Gui.so.*","/usr/lib/libQt6OpenGL.so.*","/usr/lib/libQt6OpenGLWidgets.so.*","/usr/lib/libQt6PrintSupport.so.*","/usr/lib/libQt6WaylandClient.so.*","/usr/lib/libQt6Widgets.so.*","/usr/lib/libQt6WlShellIntegration.so.*","/usr/lib/libQt6XcbQpa.so.*","/usr/lib/qt6/plugins/egldeviceintegrations/*.so","/usr/lib/qt6/plugins/platforms/*.so","/usr/lib/qt6/plugins/generic/libqevdev*.so","/usr/lib/qt6/plugins/generic/libqlibinputplugin.so","/usr/lib/qt6/plugins/generic/libqtslibplugin.so","/usr/lib/qt6/plugins/generic/libqtuiotouchplugin.so","/usr/lib/qt6/plugins/imageformats/*.so","/usr/lib/qt6/plugins/platforminputcontexts/*.so","/usr/lib/qt6/plugins/platformthemes/*.so","/usr/lib/qt6/plugins/printsupport/*.so","/usr/lib/qt6/plugins/wayland-decoration-client/*.so","/usr/lib/qt6/plugins/wayland-graphics-integration-client/*.so","/usr/lib/qt6/plugins/wayland-shell-integration/*.so","/usr/lib/qt6/plugins/xcbglintegrations/*.so","/usr/share/qt6/wayland/extensions/","/usr/share/qt6/wayland/protocols/"]},{"description":"Qt6 MySQL driver","paths":["/usr/lib/qt6/plugins/sqldrivers/libqsqlmysql.so"]},{"description":"Qt6 ODBC driver","paths":["/usr/lib/qt6/plugins/sqldrivers/libqsqlodbc.so"]},{"description":"Qt6 PostgreSQL driver","paths":["/usr/lib/qt6/plugins/sqldrivers/libqsqlpsql.so"]},{"paths":["/usr/bin","/usr/lib/qt6/*.cmake","/usr/lib/qt6/android_emulator_launcher.sh","/usr/lib/qt6/bin","/usr/lib/qt6/cmake_automoc_parser","/usr/lib/qt6/moc","/usr/lib/qt6/qlalr","/usr/lib/qt6/qt-cmake-private*","/usr/lib/qt6/qt-cmake-standalone-test","/usr/lib/qt6/qt_cyclonedx_generator.py","/usr/lib/qt6/qt-internal-configure-examples","/usr/lib/qt6/qt-internal-configure-tests","/usr/lib/qt6/rcc","/usr/lib/qt6/qvkgen","/usr/lib/qt6/syncqt","/usr/lib/qt6/tracegen","/usr/lib/qt6/tracepointgen","/usr/lib/qt6/uic","/usr/lib/qt6/qtwaylandscanner","/usr/share/qt6/json_schema/modules.json","/usr/share/qt6/wayland/"]},{"paths":["/usr/include/qt6/QtEgl*","/usr/include/qt6/Qt*/6.*/","/usr/lib/cmake/Qt6Egl*","/usr/lib/cmake/Qt6*Private","/usr/lib/libQt6Egl*.prl","/usr/lib/libQt6Egl*.so","/usr/lib/qt6/modules/Egl*.json","/usr/lib/qt6/modules/XcbQpaPrivate.json","/usr/lib/qt6/metatypes/qt6egl*.json","/usr/lib/qt6/metatypes/qt6xcb*.json","/usr/lib/qt6/modules/TestInternalsPrivate.json"]},{"paths":["/usr/lib/lib*.a","/usr/lib/libQt6DeviceDiscoverySupport.prl","/usr/lib/libQt6ExampleIcons.prl","/usr/lib/libQt6FbSupport.prl","/usr/lib/libQt6InputSupport.prl","/usr/lib/libQt6KmsSupport.prl","/usr/lib/qt6/modules/DeviceDiscoverySupportPrivate.json","/usr/lib/qt6/modules/ExampleIconsPrivate.json","/usr/lib/qt6/modules/FbSupportPrivate.json","/usr/lib/qt6/modules/InputSupportPrivate.json","/usr/lib/qt6/modules/KmsSupportPrivate.json","/usr/lib/qt6/metatypes/qt6devicediscoverysupportprivate_*metatypes.json","/usr/lib/qt6/metatypes/qt6exampleiconsprivate_*metatypes.json","/usr/lib/qt6/metatypes/qt6fbsupportprivate_*metatypes.json","/usr/lib/qt6/metatypes/qt6inputsupportprivate_*metatypes.json","/usr/lib/qt6/metatypes/qt6kmssupportprivate_*metatypes.json","/usr/lib/objects-*","/usr/lib/cmake/Qt6DeviceDiscoverySupportPrivate","/usr/lib/cmake/Qt6ExampleIconsPrivate","/usr/lib/cmake/Qt6FbSupportPrivate","/usr/lib/cmake/Qt6InputSupportPrivate","/usr/lib/cmake/Qt6KmsSupportPrivate","/usr/include/qt6/QtDeviceDiscoverySupport","/usr/include/qt6/QtExampleIcons","/usr/include/qt6/QtFbSupport","/usr/include/qt6/QtInputSupport","/usr/include/qt6/QtKmsSupport"]}]},
