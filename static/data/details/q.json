ageformats/libqpdf.so","/usr/lib/qt6/qml/QtQuick/Pdf"]},{"paths":["/usr/lib/qt6/examples/pdf*"]},{"description":"Qt6 - QtPdf components - Devel","paths":["/usr/include/qt6/QtPdf*","/usr/lib/cmake/Qt6Gui/Qt6QPdf*","/usr/lib/cmake/Qt6Pdf*","/usr/lib/cmake/Qt6Qml/QmlPlugins/Qt6Pdf*","/usr/lib/libQt6Pdf*.prl","/usr/lib/libQt6Pdf*.so","/usr/lib/pkgconfig/Qt6Pdf*.pc","/usr/lib/qt6/metatypes/qt6pdf*","/usr/lib/qt6/mkspecs/modules/qt_lib_pdf*","/usr/lib/qt6/modules/Pdf*","/usr/lib/qt6/sbom/qtpdf*"]},{"description":"WebEngine devtools_resources","paths":["/usr/share/qt6/resources/qtwebengine_devtools_resources.pak"]}]},
